@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-speedometer2 text-primary me-2"></i> Admin Paneli</h1>
        <div>
            <a asp-controller="User" asp-action="CreateUser" class="btn btn-success">
                <i class="bi bi-person-plus-fill"></i> Yeni Kullanıcı Ekle
            </a>
            <a asp-controller="User" asp-action="ListUsers" class="btn btn-primary ms-2">
                <i class="bi bi-people-fill"></i> Kullanıcı Listesi
            </a>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-people-fill text-primary fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Kullanıcılar</h5>
                    </div>
                    <h2 class="fw-bold mb-0">@ViewBag.KullaniciSayisi</h2>
                    <p class="text-muted small mb-0">Toplam kayıtlı kullanıcı</p>
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <a asp-controller="User" asp-action="ListUsers" class="text-decoration-none">
                        Tümünü Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-book-half text-success fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Kitaplar</h5>
                    </div>
                    <h2 class="fw-bold mb-0">@ViewBag.KitapSayisi</h2>
                    <p class="text-muted small mb-0">Toplam aktif kitap</p>
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <a asp-controller="Kitap" asp-action="Index" class="text-decoration-none">
                        Tümünü Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-person-badge text-info fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Öğrenciler</h5>
                    </div>
                    <h2 class="fw-bold mb-0">@ViewBag.OgrenciSayisi</h2>
                    <p class="text-muted small mb-0">Toplam aktif öğrenci</p>
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <a asp-controller="Ogrenci" asp-action="Index" class="text-decoration-none">
                        Tümünü Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-journal-arrow-up text-danger fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Ödünç</h5>
                    </div>
                    <h2 class="fw-bold mb-0">@ViewBag.AktifOduncSayisi</h2>
                    <p class="text-muted small mb-0">İade edilmemiş kitap</p>
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <a asp-controller="Rapor" asp-action="Odunc" class="text-decoration-none">
                        Raporu Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı Erişim -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-light border-0 pt-4 pb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge"></i> Hızlı Erişim</h5>
        </div>
        <div class="card-body">
            <div class="row row-cols-2 row-cols-md-4 g-3">
                <div class="col">
                    <a asp-controller="Kitap" asp-action="Create" class="card h-100 border-0 shadow-sm text-decoration-none text-dark">
                        <div class="card-body text-center py-4">
                            <div class="bg-success bg-opacity-10 p-3 rounded-circle mb-3 mx-auto" style="width: fit-content;">
                                <i class="bi bi-book-fill text-success fs-3"></i>
                            </div>
                            <h6 class="mb-0">Yeni Kitap</h6>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Ogrenci" asp-action="Ekle" class="card h-100 border-0 shadow-sm text-decoration-none text-dark">
                        <div class="card-body text-center py-4">
                            <div class="bg-info bg-opacity-10 p-3 rounded-circle mb-3 mx-auto" style="width: fit-content;">
                                <i class="bi bi-person-plus-fill text-info fs-3"></i>
                            </div>
                            <h6 class="mb-0">Yeni Öğrenci</h6>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Odunc" asp-action="Create" class="card h-100 border-0 shadow-sm text-decoration-none text-dark">
                        <div class="card-body text-center py-4">
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle mb-3 mx-auto" style="width: fit-content;">
                                <i class="bi bi-journal-plus text-warning fs-3"></i>
                            </div>
                            <h6 class="mb-0">Ödünç Ver</h6>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Rapor" asp-action="Odunc" class="card h-100 border-0 shadow-sm text-decoration-none text-dark">
                        <div class="card-body text-center py-4">
                            <div class="bg-danger bg-opacity-10 p-3 rounded-circle mb-3 mx-auto" style="width: fit-content;">
                                <i class="bi bi-clipboard-data text-danger fs-3"></i>
                            </div>
                            <h6 class="mb-0">Rapor Oluştur</h6>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 