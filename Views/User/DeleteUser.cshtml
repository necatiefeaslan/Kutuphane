@model Kutuphane.Models.User

@{
    ViewData["Title"] = "Kullanıcı Sil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="fw-bold text-danger mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i> Kullanıcı Sil</h2>
                    
                    <div class="alert alert-danger mb-4">
                        <h5 class="mb-3"><i class="bi bi-exclamation-circle"></i> Uyarı</h5>
                        <p class="mb-0">Bu kullanıcıyı silmek istediğinizden emin misiniz? Bu işlem <strong>geri alınamaz</strong>.</p>
                    </div>
                    
                    <div class="card mb-4">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Kullanıcı Adı</dt>
                                <dd class="col-sm-8">@Model.Username</dd>
                                
                                <dt class="col-sm-4">Ad</dt>
                                <dd class="col-sm-8">@Model.FirstName</dd>
                                
                                <dt class="col-sm-4">Soyad</dt>
                                <dd class="col-sm-8">@Model.LastName</dd>
                                
                                <dt class="col-sm-4">E-posta</dt>
                                <dd class="col-sm-8">@Model.Email</dd>
                                
                                <dt class="col-sm-4">Rol</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Yönetici</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Kullanıcı</span>
                                    }
                                </dd>
                                
                                <dt class="col-sm-4">Kayıt Tarihi</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>
                    
                    <form asp-action="DeleteUserConfirmed" asp-route-id="@Model.UserId" method="post">
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                <i class="bi bi-trash3 me-2"></i> Kullanıcıyı Sil
                            </button>
                            <a asp-controller="User" asp-action="ListUsers" class="btn btn-outline-secondary btn-lg w-100">
                                <i class="bi bi-arrow-left"></i> İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 