@model Kutuphane.Models.User

@{
    ViewData["Title"] = "Yeni Kullanıcı Oluştur";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="fw-bold text-success mb-4"><i class="bi bi-person-plus-fill me-2"></i> Yeni Kullanıcı Oluştur</h2>

                    <form asp-action="CreateUser" method="post" id="createUserForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label for="FirstName" class="form-label">Ad</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input name="FirstName" id="FirstName" class="form-control form-control-lg" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="LastName" class="form-label">Soyad</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input name="LastName" id="LastName" class="form-control form-control-lg" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="Username" class="form-label">Kullanıcı Adı</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                                    <input name="Username" id="Username" class="form-control form-control-lg" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="Email" class="form-label">E-posta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input name="Email" id="Email" class="form-control form-control-lg" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="Password" class="form-label">Şifre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                    <input name="Password" id="Password" class="form-control form-control-lg" type="password" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="Role" class="form-label">Rol</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-gear"></i></span>
                                    <select name="Role" id="Role" class="form-select form-select-lg">
                                        <option value="User" selected>Kullanıcı</option>
                                        <option value="Admin">Yönetici</option>
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-person-plus me-2"></i> Kullanıcı Oluştur
                            </button>
                            <a asp-controller="User" asp-action="Profile" class="btn btn-outline-secondary btn-lg w-100">
                                <i class="bi bi-arrow-left"></i> Profile Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 