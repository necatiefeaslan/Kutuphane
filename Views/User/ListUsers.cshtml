@model IEnumerable<Kutuphane.Models.User>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i> Kullanıcı Yönetimi</h1>
        <a asp-controller="User" asp-action="CreateUser" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Yeni Kullanıcı Ekle
        </a>
    </div>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- İstatistikler -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="row text-center">
                        <div class="col-md-4 border-end">
                            <h5 class="mb-0 fw-bold">@Model.Count()</h5>
                            <small class="text-muted">Toplam Kullanıcı</small>
                        </div>
                        <div class="col-md-4 border-end">
                            <h5 class="mb-0 fw-bold">@Model.Count(u => u.Role == "Admin")</h5>
                            <small class="text-muted">Yönetici</small>
                        </div>
                        <div class="col-md-4">
                            <h5 class="mb-0 fw-bold">@Model.Count(u => u.Role == "User")</h5>
                            <small class="text-muted">Normal Kullanıcı</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Kullanıcı</th>
                            <th>E-posta</th>
                            <th>Rol</th>
                            <th>Kayıt Tarihi</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle rounded-circle @(user.Role == "Admin" ? "bg-danger" : "bg-primary") bg-opacity-10 p-2 me-3">
                                            <i class="bi bi-person-fill fs-5 @(user.Role == "Admin" ? "text-danger" : "text-primary")"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@user.Username</div>
                                            <div class="small text-muted">@user.FirstName @user.LastName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-envelope text-muted me-2"></i>
                                        @user.Email
                                    </div>
                                </td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Yönetici</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Kullanıcı</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-calendar-date text-muted me-2"></i>
                                        @user.CreatedAt.ToString("dd.MM.yyyy")
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-controller="User" asp-action="UserDetails" asp-route-id="@user.UserId" class="btn btn-sm btn-info text-white">
                                            <i class="bi bi-info-circle me-1"></i> Detaylar
                                        </a>
                                        <a asp-controller="User" asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-sm btn-primary ms-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="User" asp-action="DeleteUser" asp-route-id="@user.UserId" class="btn btn-sm btn-danger ms-1">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Anasayfaya Dön
        </a>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style> 