@model Kutuphane.Models.Sinif

@{
    ViewData["Title"] = "Sınıf Güncelle";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-building text-info"></i> Sınıf Güncelle</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SinifAdi" class="form-label">Sınıf Adı</label>
                <input asp-for="SinifAdi" class="form-control" placeholder="Sınıf adını güncelleyin" id="sinifAdi" />
                <span asp-validation-for="SinifAdi" class="text-danger small"></span>
                <div class="form-text text-muted">
                    Sınıf adı 1-12 arasında bir sayı olmalı ve opsiyonel olarak şube içermelidir (Örn: 9 veya 9-A).
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Aciklama" class="form-label">Açıklama</label>
                <input asp-for="Aciklama" class="form-control" placeholder="Açıklama girin" />
                <span asp-validation-for="Aciklama" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-warning w-100 d-flex align-items-center justify-content-center fs-5">
                <i class="bi bi-arrow-repeat me-2"></i> Güncelle
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sınıf adı inputu
            var sinifAdiInput = document.getElementById('sinifAdi');
            
            // Form submit olduğunda
            document.querySelector('form').addEventListener('submit', function(e) {
                var sinifAdi = sinifAdiInput.value.trim();
                
                // Boş değilse doğrulama yap
                if (sinifAdi) {
                    var sinifNumarasi = sinifAdi;
                    
                    // Eğer şube içeriyorsa (örn: 9-A), rakam kısmını al
                    if (sinifAdi.includes('-')) {
                        sinifNumarasi = sinifAdi.split('-')[0];
                    }
                    
                    // Geçerli bir sayı mı?
                    var sayi = parseInt(sinifNumarasi);
                    
                    // 1-12 arasında değilse
                    if (isNaN(sayi) || sayi < 1 || sayi > 12) {
                        e.preventDefault(); // Formu gönderme
                        
                        // Hata mesajını göster
                        var validationSpan = sinifAdiInput.nextElementSibling;
                        validationSpan.textContent = "Sınıf adı 1-12 arasında bir sayı olmalıdır.";
                        
                        // Input'a hata sınıfı ekle
                        sinifAdiInput.classList.add('is-invalid');
                    }
                }
            });
            
            // Input değiştiğinde hata sınıfını kaldır
            sinifAdiInput.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
        });
    </script>
}