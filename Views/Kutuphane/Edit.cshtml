@model Kutuphane.Models.Sinif

@{
    ViewData["Title"] = "Sınıf Düzenle";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">✏️ Sınıf Düzenle</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div class="mb-3">
                    <label asp-for="Id" class="form-label">ID</label>
                    <input asp-for="Id" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label asp-for="SinifAdi" class="form-label">Sınıf Adı</label>
                    <input asp-for="SinifAdi" class="form-control" />
                    <span asp-validation-for="SinifAdi" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label">Açıklama</label>
                    <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Geri Dön
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}