@model Kutuphane.Models.Sinif

@{
    ViewData["Title"] = "Sınıf Detay";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">📄 Sınıf Detayları</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold text-end">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold text-end">Sınıf Adı:</dt>
                <dd class="col-sm-9">@Model.SinifAdi</dd>

                <dt class="col-sm-3 fw-bold text-end">Açıklama:</dt>
                <dd class="col-sm-9">@Model.Aciklama</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Geri Dön
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Düzenle
            </a>
        </div>
    </div>
</div>