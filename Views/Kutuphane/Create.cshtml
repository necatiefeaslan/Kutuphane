@model Kutuphane.Models.Sinif

@{
    ViewData["Title"] = "Yeni Sınıf Ekle";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold mb-4 text-success d-flex align-items-center">
                    <i class="bi bi-building me-2"></i> Yeni Sınıf Ekle
                </h2>
                <form asp-action="Create" method="post" autocomplete="off">
                    <div class="mb-4 position-relative">
                        <label asp-for="SinifAdi" class="form-label">Sınıf Adı</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                            <input asp-for="SinifAdi" class="form-control form-control-lg" placeholder="Örn: 10-A" />
                        </div>
                        <span asp-validation-for="SinifAdi" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="Aciklama" class="form-label">Açıklama</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-card-text"></i></span>
                            <textarea asp-for="Aciklama" class="form-control form-control-lg" rows="3" placeholder="Açıklama giriniz..."></textarea>
                        </div>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="bi bi-arrow-left"></i> Geri Dön
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="bi bi-plus-circle"></i> Ekle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .input-group-text i {
        font-size: 1.2rem;
        color: #198754;
    }
    .card {
        transition: box-shadow 0.3s;
    }
    .card:hover {
        box-shadow: 0 0 24px 0 rgba(25,135,84,0.15);
    }
</style>