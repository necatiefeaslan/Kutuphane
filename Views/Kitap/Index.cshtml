@model IEnumerable<Kutuphane.Models.Kitap>

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold mb-0"><i class="bi bi-book-half text-primary me-2"></i> Kitaplar</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Yeni Kitap
        </a>
    </div>
    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Kitap Adı</th>
                <th>Yazar</th>
                <th>ISBN</th>
                <th>Yayın Yılı</th>
                <th>Stok</th>
                <th>Kategori</th>
                <th class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td>@item.KitapAdi</td>
                <td>@item.Yazar</td>
                <td>@item.ISBN</td>
                <td>@item.YayinYili</td>
                <td>@item.StokAdedi</td>
                <td>@item.Kategori?.KategoriAdi</td>
                <td class="text-center">
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Güncelle
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                            <i class="bi bi-eye"></i> Detay
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                        <a asp-controller="Odunc" asp-action="Create" asp-route-kitapId="@item.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-journal-arrow-up"></i> Ödünç Ver
                        </a>
                    </div>
                </td>
            </tr>
}
        </tbody>
    </table>
</div> 