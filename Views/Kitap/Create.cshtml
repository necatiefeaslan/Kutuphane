@model Kutuphane.Models.Kitap

@{
    ViewData["Title"] = "Yeni Kitap";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm rounded-4">
            <div class="card-body">
                <h2 class="fw-bold mb-4">Yeni Kitap Ekle</h2>
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="KitapAdi" class="form-label"></label>
                        <input asp-for="KitapAdi" class="form-control" />
                        <span asp-validation-for="KitapAdi" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Yazar" class="form-label"></label>
                        <input asp-for="Yazar" class="form-control" />
                        <span asp-validation-for="Yazar" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ISBN" class="form-label"></label>
                        <input asp-for="ISBN" class="form-control" />
                        <span asp-validation-for="ISBN" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="YayinYili" class="form-label"></label>
                        <input asp-for="YayinYili" class="form-control" />
                        <span asp-validation-for="YayinYili" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="StokAdedi" class="form-label"></label>
                        <input asp-for="StokAdedi" class="form-control" />
                        <span asp-validation-for="StokAdedi" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="KategoriId" class="form-label">Kategori</label>
                        <select asp-for="KategoriId" class="form-control" asp-items="ViewBag.KategoriId">
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="KategoriId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 