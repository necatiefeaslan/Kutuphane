@model Kutuphane.Models.Kitap

@{
    ViewData["Title"] = "Yeni Kitap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold mb-4 text-primary d-flex align-items-center">
                    <i class="bi bi-book-half me-2"></i> Yeni Kitap Ekle
                </h2>
                <form asp-action="Create" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <div class="mb-4 position-relative">
                        <label asp-for="KitapAdi" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-journal"></i></span>
                            <input asp-for="KitapAdi" class="form-control form-control-lg" placeholder="Kitap adı girin..." />
                        </div>
                        <span asp-validation-for="KitapAdi" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="Yazar" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="Yazar" class="form-control form-control-lg" placeholder="Yazar adı girin..." />
                        </div>
                        <span asp-validation-for="Yazar" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="ISBN" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-upc-scan"></i></span>
                            <input asp-for="ISBN" class="form-control form-control-lg" placeholder="ISBN girin..." />
                        </div>
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="YayinYili" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                            <input asp-for="YayinYili" class="form-control form-control-lg" placeholder="Yayın yılı girin..." />
                        </div>
                        <span asp-validation-for="YayinYili" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="StokAdedi" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-archive"></i></span>
                            <input asp-for="StokAdedi" class="form-control form-control-lg" placeholder="Stok adedi girin..." />
                        </div>
                        <span asp-validation-for="StokAdedi" class="text-danger small"></span>
                    </div>
                    <div class="mb-4 position-relative">
                        <label asp-for="KategoriId" class="form-label">Kategori</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-tags"></i></span>
                            <select asp-for="KategoriId" class="form-select form-select-lg" asp-items="ViewBag.KategoriId">
                                <option value="">-- Kategori Seçin --</option>
                            </select>
                        </div>
                        <span asp-validation-for="KategoriId" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
                        <button type="submit" class="btn btn-primary btn-lg px-4"><i class="bi bi-plus-circle me-1"></i> Ekle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<style>
    .input-group-text i {
        font-size: 1.2rem;
        color: #0d6efd;
    }
    .card {
        transition: box-shadow 0.3s;
    }
    .card:hover {
        box-shadow: 0 0 24px 0 rgba(13,110,253,0.15);
    }
</style> 