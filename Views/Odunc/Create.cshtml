@model Kutuphane.Models.Odunc

@{
    ViewData["Title"] = "Yeni Ödünç Verme";
    var seciliKitapId = ViewData["SeciliKitapId"] as int?;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold mb-4 text-success d-flex align-items-center">
                    <i class="bi bi-journal-arrow-up me-2"></i> Yeni Ödünç Verme
                </h2>
                <form asp-action="Create" method="post" id="oduncForm" autocomplete="off">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">Kitap</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-journal"></i></span>
                                @if (seciliKitapId != null)
                                {
                                    var kitapList = ViewData["KitapId"] as SelectList;
                                    if (kitapList != null)
                                    {
                                        var kitapAdi = kitapList.FirstOrDefault(k => k?.Value == seciliKitapId.ToString())?.Text;
                                        <input type="hidden" asp-for="KitapId" value="@seciliKitapId" />
                                        <input type="text" class="form-control form-control-lg" value="@kitapAdi" readonly />
                                    }
                                }
                                else
                                {
                                    <select asp-for="KitapId" class="form-select form-select-lg kitap-select" id="kitapSelect">
                                        <option value="">-- Kitap Seçin --</option>
                                    </select>
                                }
                            </div>
                            <span asp-validation-for="KitapId" class="text-danger small"></span>
                            <div id="kitapBilgi" class="small text-muted mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OgrenciId" class="form-label">Öğrenci</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <select asp-for="OgrenciId" class="form-select form-select-lg ogrenci-select" id="ogrenciSelect">
                                    <option value="">-- Öğrenci Seçin --</option>
                                </select>
                            </div>
                            <span asp-validation-for="OgrenciId" class="text-danger small"></span>
                            <div id="ogrenciBilgi" class="small text-muted mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">İade Tarihi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar-check"></i></span>
                                <input type="date" class="form-control form-control-lg" asp-for="IadeTarihi" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                            </div>
                            <span asp-validation-for="IadeTarihi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ödünç Alma Tarihi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" class="form-control form-control-lg" name="OduncAlmaTarihi" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="mt-5 d-flex gap-3">
                        <button type="submit" class="btn btn-success btn-lg w-100 d-flex align-items-center justify-content-center fs-5" id="submitBtn">
                            <i class="bi bi-arrow-repeat me-2"></i> Ödünç Ver
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-arrow-left"></i> Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Select2 için Kitap Arama
            $('.kitap-select').select2({
                theme: "bootstrap-5",
                dropdownParent: $('.kitap-select').parent(),
                placeholder: '-- Kitap Ara --',
                allowClear: true,
                minimumInputLength: 2,
                language: {
                    inputTooShort: function() {
                        return 'En az 2 karakter giriniz...';
                    },
                    noResults: function() {
                        return 'Sonuç bulunamadı';
                    },
                    searching: function() {
                        return 'Aranıyor...';
                    }
                },
                ajax: {
                    url: '/Odunc/AraKitaplar',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            term: params.term
                        };
                    },
                    processResults: function(data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });

            // Select2 için Öğrenci Arama
            $('.ogrenci-select').select2({
                theme: "bootstrap-5",
                dropdownParent: $('.ogrenci-select').parent(),
                placeholder: '-- Öğrenci Ara --',
                allowClear: true,
                minimumInputLength: 2,
                language: {
                    inputTooShort: function() {
                        return 'En az 2 karakter giriniz...';
                    },
                    noResults: function() {
                        return 'Sonuç bulunamadı';
                    },
                    searching: function() {
                        return 'Aranıyor...';
                    }
                },
                ajax: {
                    url: '/Odunc/AraOgrenciler',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            term: params.term
                        };
                    },
                    processResults: function(data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });
            
            // Select2 kontrol ID'lerini ayarla
            $('.select2-selection').attr('id', 'select2-selection');
            $('.select2-search__field').attr('id', 'select2-search');

            // Form validasyonu
            $('#oduncForm').on('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                }
            });

            // Kitap seçimi değiştiğinde
            $('#kitapSelect').on('change', function() {
                const kitapId = $(this).val();
                if (kitapId) {
                    // Kitap bilgilerini getir
                    $.get('/Odunc/GetKitapBilgi/' + kitapId, function(data) {
                        $('#kitapBilgi').html(`
                            <i class="bi bi-info-circle"></i> 
                            Stok: ${data.stok} | 
                            Kategori: ${data.kategori}
                        `);
                    });
                } else {
                    $('#kitapBilgi').html('');
                }
            });

            // Öğrenci seçimi değiştiğinde
            $('#ogrenciSelect').on('change', function() {
                const ogrenciId = $(this).val();
                if (ogrenciId) {
                    // Öğrenci bilgilerini getir
                    $.get('/Odunc/GetOgrenciBilgi/' + ogrenciId, function(data) {
                        $('#ogrenciBilgi').html(`
                            <i class="bi bi-person"></i> 
                            Sınıf: ${data.sinif} | 
                            Aktif Ödünç: ${data.aktifOdunc}
                        `);
                    });
                } else {
                    $('#ogrenciBilgi').html('');
                }
            });

            // Form validasyonu
            function validateForm() {
                let isValid = true;
                const kitapId = $('#kitapSelect').val();
                const ogrenciId = $('#ogrenciSelect').val();
                const iadeTarihi = $('[name="IadeTarihi"]').val();

                if (!kitapId) {
                    $('#kitapSelect').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#kitapSelect').removeClass('is-invalid');
                }

                if (!ogrenciId) {
                    $('#ogrenciSelect').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#ogrenciSelect').removeClass('is-invalid');
                }

                if (!iadeTarihi) {
                    $('[name="IadeTarihi"]').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('[name="IadeTarihi"]').removeClass('is-invalid');
                }

                return isValid;
            }
        });
    </script>
}
<style>
    .input-group-text i {
        font-size: 1.2rem;
        color: #198754;
    }
    .card {
        transition: box-shadow 0.3s;
    }
    .card:hover {
        box-shadow: 0 0 24px 0 rgba(25,135,84,0.15);
    }
    .select2-container {
        width: 100% !important;
    }
    .select2-container .select2-selection--single {
        height: 48px;
    }
    .select2-container--bootstrap-5 .select2-selection {
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        border-radius: 0.375rem;
    }
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        padding-top: 0.25rem;
    }
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
        top: 10px;
        right: 10px;
    }
</style> 