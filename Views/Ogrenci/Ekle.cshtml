@model Ogrenci

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold mb-4 text-primary d-flex align-items-center">
                    <i class="bi bi-person-plus me-2"></i> Öğrenci Ekle
                </h2>
                <form asp-action="Ekle" method="post" autocomplete="off">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="OgrenciAdi" class="form-label">Adı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="OgrenciAdi" class="form-control form-control-lg" placeholder="Öğrenci adını girin" />
                            </div>
                            <span asp-validation-for="OgrenciAdi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OgrenciSoyadi" class="form-label">Soyadı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="OgrenciSoyadi" class="form-control form-control-lg" placeholder="Öğrenci soyadını girin" />
                            </div>
                            <span asp-validation-for="OgrenciSoyadi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OkulNumarasi" class="form-label">Okul Numarası</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-123"></i></span>
                                <input asp-for="OkulNumarasi" class="form-control form-control-lg" placeholder="Öğrenci okul numarası" />
                            </div>
                            <span asp-validation-for="OkulNumarasi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SinifId" class="form-label">Sınıf</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                <select asp-for="SinifId" asp-items="@(ViewBag.Siniflar)" class="form-select form-select-lg">
                                    <option value="0">Bir Sınıf Seç</option>
                                </select>
                            </div>
                            <span asp-validation-for="SinifId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-5">
                        <button type="submit" class="btn btn-success btn-lg w-100 d-flex align-items-center justify-content-center fs-5">
                            <i class="bi bi-person-plus me-2"></i> Öğrenciyi Ekle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .input-group-text i {
        font-size: 1.2rem;
        color: #0d6efd;
    }
    .card {
        transition: box-shadow 0.3s;
    }
    .card:hover {
        box-shadow: 0 0 24px 0 rgba(13,110,253,0.15);
    }
</style>
