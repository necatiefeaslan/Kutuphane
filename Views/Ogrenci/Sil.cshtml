@model Ogrenci

<div class="container mt-4">
    <div class="alert alert-warning border border-danger shadow-sm">
        <h2 class="text-danger">⚠️ Öğrenci Sil</h2>
        <p class="mt-3">
            <strong>@Model.OgrenciAdi @Model.OgrenciSoyadi</strong> adlı öğrenciyi silmek istediğinize emin misiniz?
            Bu işlem geri alınamaz!
        </p>
    </div>

    <form asp-action="Sil" method="post" asp-controller="Ogrenci" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            🗑️ Sil
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            ❌ İptal
        </a>
    </form>
</div>
