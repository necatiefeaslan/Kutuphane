@model List<Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">📋 Öğrenci Listesi</h1>
        <a href="/Ogrenci/Ekle" class="btn btn-success">
            ➕ Yeni Öğrenci Ekle
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-bordered table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Id</th>
                    <th>Adı</th>
                    <th>Soyadı</th>
                    <th>Okul Numarası</th>
                    <th>Sınıf</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ogrenci in Model)
                {
                    <tr>
                        <td>@ogrenci.Id</td>
                        <td>@ogrenci.OgrenciAdi</td>
                        <td>@ogrenci.OgrenciSoyadi</td>
                        <td>@ogrenci.OkulNumarasi</td>
                        <td>@ogrenci.Sinif?.SinifAdi</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/Ogrenci/Guncelle/@ogrenci.Id" class="btn btn-warning btn-sm">
                                    ✏️ Güncelle
                                </a>
                                <a href="/Ogrenci/Sil/@ogrenci.Id" class="btn btn-danger btn-sm">
                                    🗑️ Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Henüz öğrenci kaydı bulunmamaktadır.
        </div>
    }
</div>
