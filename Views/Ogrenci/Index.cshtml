@model List<Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0"><i class="bi bi-people-fill text-warning me-2"></i> Öğrenci Listesi</h1>
        <a href="/Ogrenci/Ekle" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Yeni Öğrenci Ekle
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-bordered table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    
                    <th>Öğrenci Adı</th>
                    <th>Öğrenci Soyadı</th>
                    <th>Okul Numarası</th>
                    <th>Sınıf</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ogrenci in Model)
                {
                    <tr>
                        
                        <td>@ogrenci.OgrenciAdi</td>
                        <td>@ogrenci.OgrenciSoyadi</td>
                        <td>@ogrenci.OkulNumarasi</td>
                        <td>@ogrenci.Sinif?.SinifAdi</td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="/Ogrenci/Guncelle/@ogrenci.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Güncelle
                                </a>
                                <a href="/Ogrenci/Sil/@ogrenci.Id" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Henüz öğrenci kaydı bulunmamaktadır.
        </div>
    }
</div>
