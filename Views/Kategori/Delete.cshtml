@model Kutuphane.Models.Kategori

@{
    ViewData["Title"] = "Kategori Sil";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger rounded-4">
            <div class="card-body">
                <h2 class="fw-bold mb-4 text-danger">Kategori Sil</h2>
                <div class="alert alert-danger mb-4">
                    <strong>Uyarı:</strong> Bu kategoriyi silmek istediğinize emin misiniz?
                </div>
                <dl class="row mb-4">
                    <dt class="col-sm-4">Kategori Adı:</dt>
                    <dd class="col-sm-8">@Model.KategoriAdi</dd>
                    <dt class="col-sm-4">Açıklama:</dt>
                    <dd class="col-sm-8">@Model.Aciklama</dd>
                </dl>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                        <button type="submit" class="btn btn-danger">Sil</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div> 