@model IEnumerable<Kutuphane.Models.Kategori>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="fw-bold mb-0"><i class="bi bi-tags-fill text-success me-2"></i> Kategoriler</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Yeni Kategori
        </a>
    </div>
    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-light">
            <tr>
               
                <th>Kategori Adı</th>
                <th>Açıklama</th>
                <th class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
               
                <td>@item.KategoriAdi</td>
                <td>@item.Aciklama</td>
                <td class="text-center">
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Güncelle
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                            <i class="bi bi-eye"></i> Detay
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                    </div>
                </td>
            </tr>
}
        </tbody>
    </table>
</div> 